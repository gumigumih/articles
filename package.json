{
  "name": "writing-workspace",
  "version": "1.0.0",
  "description": "Shared workspace for Zenn, Qiita, and note articles",
  "main": "index.js",
  "scripts": {
    "preview": "concurrently \"npm --prefix zenn run preview\" \"npm --prefix qiita run preview\" \"sleep 2 && open-cli http://localhost:8000\"",
    "qiita:new": "npm --prefix qiita run new",
    "qiita:preview": "npm --prefix qiita run preview",
    "qiita:publish": "npm --prefix qiita run publish",
    "zenn:new": "npm --prefix zenn run new",
    "zenn:preview": "npm --prefix zenn run preview",
    "convert:zenn-to-qiita": "node scripts/convert-zenn-to-qiita.js",
    "postinstall": "./scripts/setup-git-hooks.sh"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gumigumih/articles.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/gumigumih/articles/issues"
  },
  "homepage": "https://github.com/gumigumih/articles#readme",
  "dependencies": {
    "gray-matter": "^4.0.3",
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "open-cli": "^8.0.0"
  }
}
